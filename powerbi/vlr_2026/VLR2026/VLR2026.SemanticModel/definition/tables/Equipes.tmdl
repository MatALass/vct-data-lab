table Equipes
	lineageTag: c190fbdc-17a8-5870-835b-e38c2257a7d1

	/// Score de 0 à 100 du modèle de profils (stabilité des compos, pool d'agents, identité par map, fiabilité de l'échantillon), voir data/models/team_profile_scores.csv
	measure 'Score profil tactique' = AVERAGE(Equipes[Score profil])
		formatString: 0.0
		displayFolder: Équipes
		lineageTag: f6d03b73-0aab-58df-b053-7bff3cd1cf1c

	column 'Équipe'
		dataType: string
		lineageTag: 4a84e316-e680-50ad-9ffd-a9f1919eface
		summarizeBy: none
		sourceColumn: Équipe

		annotation SummarizationSetBy = Automatic

	column 'Région'
		dataType: string
		lineageTag: d6e40632-7890-5e0a-b15f-a15c8eed0a7a
		summarizeBy: none
		sourceColumn: Région

		annotation SummarizationSetBy = Automatic

	column 'Profil tactique'
		dataType: string
		lineageTag: 654373a0-ed9d-5a4e-8ab4-91023db90398
		summarizeBy: none
		sourceColumn: Profil tactique

		annotation SummarizationSetBy = Automatic

	column 'Score profil'
		dataType: double
		formatString: #,##0.00
		isHidden
		lineageTag: cb9530ec-672c-5098-91e7-db9c7ac6b804
		summarizeBy: sum
		sourceColumn: Score profil

		annotation SummarizationSetBy = Automatic

	column 'Taux de réutilisation'
		dataType: double
		formatString: #,##0.00
		isHidden
		lineageTag: 1630010f-46f0-56e5-b237-a7023b753df4
		summarizeBy: average
		sourceColumn: Taux de réutilisation

		annotation SummarizationSetBy = Automatic

	partition Equipes = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Equipes.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"Équipe", type text}, {"Région", type text}, {"Profil tactique", type text}, {"Score profil", type number}, {"Taux de réutilisation", type number}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
