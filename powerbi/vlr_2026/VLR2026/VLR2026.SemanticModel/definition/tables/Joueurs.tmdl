table Joueurs
	lineageTag: 34e2a0f6-f202-534d-9afe-cac3d3bec313

	/// Nombre de joueurs (EMEA Stage 1 uniquement)
	measure Joueurs = COUNTROWS(Joueurs)
		formatString: #,##0
		displayFolder: Joueurs
		lineageTag: 08f1a968-46fa-5a8f-a91a-2889c2cb9095

	/// Rounds joués par les joueurs sélectionnés
	measure 'Rounds joués' = SUM(Joueurs[Rounds])
		formatString: #,##0
		displayFolder: Joueurs
		lineageTag: d4106dff-1fe9-5b45-9fcb-f3ba2e5021c5

	/// Rating vlr.gg pondéré par les rounds joués, pour qu'un remplaçant ne pèse pas autant qu'un titulaire
	measure 'Rating moyen' = DIVIDE(SUMX(Joueurs, Joueurs[Rating] * Joueurs[Rounds]), [Rounds joués])
		formatString: 0.00
		displayFolder: Joueurs
		lineageTag: 3bc7e330-a25f-5a23-9ae1-293535f7dd9d

	/// Average combat score pondéré par les rounds
	measure 'ACS moyen' = DIVIDE(SUMX(Joueurs, Joueurs[ACS] * Joueurs[Rounds]), [Rounds joués])
		formatString: 0
		displayFolder: Joueurs
		lineageTag: e02ba721-cc5f-501d-81d0-ca3e9e08c59a

	/// Dégâts moyens par round, pondérés par les rounds
	measure 'ADR moyen' = DIVIDE(SUMX(Joueurs, Joueurs[ADR] * Joueurs[Rounds]), [Rounds joués])
		formatString: 0
		displayFolder: Joueurs
		lineageTag: 9b9aec68-cd0f-5e66-a1c1-679964fa7b7d

	/// Part des rounds avec un kill, une assist, une survie ou un trade, pondérée par les rounds
	measure 'KAST moyen' = DIVIDE(SUMX(Joueurs, Joueurs[KAST] * Joueurs[Rounds]), [Rounds joués])
		formatString: 0 %
		displayFolder: Joueurs
		lineageTag: 4f2a98e2-991f-508e-806c-4cfb0fafb6b5

	/// Premiers kills moins premières morts, par round ; positif = gagne ses duels d'ouverture
	measure 'First kills - first deaths' = DIVIDE(SUMX(Joueurs, (Joueurs[FKPR] - Joueurs[FDPR]) * Joueurs[Rounds]), [Rounds joués])
		formatString: +0.00;-0.00;0.00
		displayFolder: Joueurs
		lineageTag: e8f584b5-32d2-5c6f-92e0-a41c6d0b9228

	/// Couleur de mise en évidence de Rating moyen
	measure 'Couleur Rating moyen' =
			VAR _v = [Rating moyen]
			RETURN SWITCH(
			    TRUE(),
			    ISBLANK(_v), BLANK(),
			    _v < 0.95, "#E03131",
			    _v < 1.1, "#F59F00",
			    "#12B886"
			)
		displayFolder: Couleurs
		isHidden
		lineageTag: d8b573e6-94cb-5c03-b5dc-bf3b43e641d9

	column Joueur
		dataType: string
		lineageTag: b1d95d39-3269-5274-aa95-b0326d3aed14
		summarizeBy: none
		sourceColumn: Joueur

		annotation SummarizationSetBy = Automatic

