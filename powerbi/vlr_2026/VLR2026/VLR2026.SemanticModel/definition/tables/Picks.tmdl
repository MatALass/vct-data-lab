table Picks
	lineageTag: 7a3cfea8-357c-557b-b62d-383d443ee3f6

	/// Part des compositions qui contiennent l'agent (ou au moins un agent du rôle), calculée sur les compositions du filtre en cours : le filtre agent ou rôle ne touche pas au dénominateur
	measure 'Pick rate' = DIVIDE(DISTINCTCOUNT(Picks[CompID]), [Compositions])
		formatString: 0 %
		displayFolder: Agents
		lineageTag: a34c02ff-84d2-544a-8538-5f245f7e0f40

	/// Pick rate de l'agent sur toutes les maps, avec les autres filtres
	measure 'Pick rate toutes maps' = CALCULATE([Pick rate], REMOVEFILTERS(Maps))
		formatString: 0 %
		displayFolder: Agents
		lineageTag: f244b5cf-b868-5f9a-8dcf-f5367f21bcbd

	/// Différence entre le pick rate sur la map et le pick rate toutes maps ; positif = agent de cette map
	measure 'Écart à sa moyenne' = [Pick rate] - [Pick rate toutes maps]
		formatString: +0 %;-0 %;0 %
		displayFolder: Agents
		lineageTag: 084b0ccd-e3df-5d65-b441-7884217973ea

	/// Nombre moyen d'agents du rôle par composition (ex. 1,3 duelliste par compo)
	measure 'Agents par compo' = DIVIDE(COUNTROWS(Picks), [Compositions])
		formatString: 0.00
		displayFolder: Agents
		lineageTag: c48912b3-6318-502c-ab64-03c2be30138e

	/// Nombre d'agents différents joués au moins une fois
	measure 'Agents joués' = DISTINCTCOUNT(Picks[Agent])
		formatString: #,##0
		displayFolder: Agents
		lineageTag: 42c23fa9-7b84-5a72-9975-5de7d12f0fa7

	/// Nombre d'équipes qui ont joué l'agent au moins une fois
	measure 'Équipes qui le jouent' = DISTINCTCOUNT(Picks[Équipe])
		formatString: #,##0
		displayFolder: Agents
		lineageTag: 539bbd1b-f607-5def-bd98-99613ba286bb

	/// Couleur de mise en évidence de Pick rate
	measure 'Couleur Pick rate' =
			VAR _v = [Pick rate]
			RETURN SWITCH(
			    TRUE(),
			    ISBLANK(_v), BLANK(),
			    _v < 0.1, "#677386",
			    _v < 0.5, "#F59F00",
			    "#FF4655"
			)
		displayFolder: Couleurs
		isHidden
		lineageTag: e0ed5657-a759-564c-ac0b-65d4bd4cc031

	column CompID
		dataType: string
		isHidden
		lineageTag: 042a69e4-061e-5ce5-8b7d-996d34180fff
		summarizeBy: none
		sourceColumn: CompID

		annotation SummarizationSetBy = Automatic

	column 'Événement'
		dataType: string
		isHidden
		lineageTag: b18f2567-be41-521f-a15b-279f18baa796
		summarizeBy: none
		sourceColumn: Événement

		annotation SummarizationSetBy = Automatic

	column Map
		dataType: string
		isHidden
		lineageTag: f37ac4db-4bba-5499-973a-c59955032670
		summarizeBy: none
		sourceColumn: Map

		annotation SummarizationSetBy = Automatic

	column 'Équipe'
		dataType: string
		isHidden
		lineageTag: a391aeef-fe7d-56c4-8db3-8de3db61799f
		summarizeBy: none
		sourceColumn: Équipe

		annotation SummarizationSetBy = Automatic

	column Agent
		dataType: string
		isHidden
		lineageTag: 52c38dbe-1923-5c1d-b7a0-cbf032208533
		summarizeBy: none
		sourceColumn: Agent

		annotation SummarizationSetBy = Automatic

	partition Picks = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Picks.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"CompID", type text}, {"Événement", type text}, {"Map", type text}, {"Équipe", type text}, {"Agent", type text}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
