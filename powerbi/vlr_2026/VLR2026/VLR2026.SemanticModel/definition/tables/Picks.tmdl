table Picks
	lineageTag: 7a3cfea8-357c-557b-b62d-383d443ee3f6

	/// Part des compositions qui contiennent l'agent (ou au moins un agent du rôle), calculée sur les compositions du filtre en cours : le filtre agent ou rôle ne touche pas au dénominateur
	measure 'Pick rate' = DIVIDE(DISTINCTCOUNT(Picks[CompID]), [Compositions])
		formatString: 0 %
		displayFolder: Agents
		lineageTag: a34c02ff-84d2-544a-8538-5f245f7e0f40

	/// Part des maps gagnées par les compositions qui contiennent l'agent
	measure 'Winrate de l''agent' = DIVIDE(CALCULATE(DISTINCTCOUNT(Picks[CompID]), Picks[Victoire] = 1), DISTINCTCOUNT(Picks[CompID]))
		formatString: 0 %
		displayFolder: Agents
		lineageTag: 7b29247b-ea89-5718-8e62-b79e7ba611e7

	/// Nombre de compositions qui contiennent l'agent ; sert à écarter les winrates sur trop peu de maps
	measure 'Maps avec l''agent' = DISTINCTCOUNT(Picks[CompID])
		formatString: #,##0
		displayFolder: Agents
		lineageTag: a7a33088-e852-58ad-ba24-bb27d2ec8cf7

	/// Nombre moyen d'agents du rôle par composition (ex. 1,3 duelliste par compo)
	measure 'Agents par compo' = DIVIDE(COUNTROWS(Picks), [Compositions])
		formatString: 0.00
		displayFolder: Agents
		lineageTag: c48912b3-6318-502c-ab64-03c2be30138e

	/// Nombre d'agents différents joués au moins une fois
	measure 'Agents joués' = DISTINCTCOUNT(Picks[Agent])
		formatString: #,##0
		displayFolder: Agents
		lineageTag: 42c23fa9-7b84-5a72-9975-5de7d12f0fa7

	/// Nombre d'équipes qui ont joué l'agent au moins une fois
	measure 'Équipes qui le jouent' = DISTINCTCOUNT(Picks[Équipe])
		formatString: #,##0
		displayFolder: Agents
		lineageTag: 539bbd1b-f607-5def-bd98-99613ba286bb

	/// Couleur de mise en évidence de Winrate de l'agent
	measure 'Couleur Winrate de l''agent' =
			VAR _v = [Winrate de l'agent]
			RETURN SWITCH(
			    TRUE(),
			    ISBLANK(_v), BLANK(),
			    _v < 0.45, "#E03131",
			    _v < 0.55, "#F59F00",
			    "#12B886"
			)
		displayFolder: Couleurs
		isHidden
		lineageTag: fe3327a4-e33e-5ac3-825b-e45e97d5828b

	/// Couleur de mise en évidence de Pick rate
	measure 'Couleur Pick rate' =
			VAR _v = [Pick rate]
			RETURN SWITCH(
			    TRUE(),
			    ISBLANK(_v), BLANK(),
			    _v < 0.1, "#677386",
			    _v < 0.5, "#F59F00",
			    "#FF4655"
			)
		displayFolder: Couleurs
		isHidden
		lineageTag: e0ed5657-a759-564c-ac0b-65d4bd4cc031

	column CompID
		dataType: string
		isHidden
		lineageTag: 042a69e4-061e-5ce5-8b7d-996d34180fff
		summarizeBy: none
		sourceColumn: CompID

		annotation SummarizationSetBy = Automatic

	column 'Événement'
		dataType: string
		isHidden
		lineageTag: b18f2567-be41-521f-a15b-279f18baa796
		summarizeBy: none
		sourceColumn: Événement

		annotation SummarizationSetBy = Automatic

	column Map
		dataType: string
		isHidden
		lineageTag: f37ac4db-4bba-5499-973a-c59955032670
		summarizeBy: none
		sourceColumn: Map

		annotation SummarizationSetBy = Automatic

	column 'Équipe'
		dataType: string
		isHidden
		lineageTag: a391aeef-fe7d-56c4-8db3-8de3db61799f
		summarizeBy: none
		sourceColumn: Équipe

		annotation SummarizationSetBy = Automatic

	column Agent
		dataType: string
		isHidden
		lineageTag: 52c38dbe-1923-5c1d-b7a0-cbf032208533
		summarizeBy: none
		sourceColumn: Agent

		annotation SummarizationSetBy = Automatic

	column Victoire
		dataType: int64
		formatString: #,##0
		isHidden
		lineageTag: 30a48570-3890-56f8-8cfb-86a34c03020e
		summarizeBy: sum
		sourceColumn: Victoire

		annotation SummarizationSetBy = Automatic

	partition Picks = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Picks.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"CompID", type text}, {"Événement", type text}, {"Map", type text}, {"Équipe", type text}, {"Agent", type text}, {"Victoire", Int64.Type}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
